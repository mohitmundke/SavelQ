# ============================================================
# SaveIQ Configuration - Matches System Architecture Diagram
# ============================================================

# AI Engine (Groq Cloud & OpenAI)
# Free Groq key: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
# OpenAI key: https://platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here

# Database (PostgreSQL / Supabase)
# Leave empty to use local auto-provisioned SQLite (saveiq.db)
# Example Supabase URI: postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# FastAPI Backend Server Configuration
PORT=8000
HOST=127.0.0.1
